# Binaries for the BRIDGE arms. A TEMPLATE: adapt the module names (or PATH
# entries) to your own cluster, then source this AFTER activating the venv:
#
#   source .venv/bin/activate && source tools.env
#
# Every PBS job sources it too (config.yaml: tools.tools_env). Only the tools
# are taken from here: the jobs call the venv's `bridge` by absolute path, so
# whatever `python` a module puts on PATH is never used.
#
# Not needed at all with a conda environment built from environment.yml; set
# `tools: tools_env: null` in config.yaml instead.
#
# Verify with `bridge check`, which resolves every binary by name.

# Make your site's module tree visible, if it is not by default:
# module use -a /path/to/modulefiles

# Versions BRIDGE was validated with. Check the names your site uses with
# `module avail <tool>`.
module load kallisto/0.52.0
module load mash/2.3
module load minimap2/2.31
module load bwa-mem2/2.2.1
module load samtools/1.23.1
module load blast/2.11.0
module load viralconsensus/1.0.1
module load clique-snv/2.0.3
module load java
module load kma/1.6.6

# Or, for tools installed outside a module system, add them to PATH:
# export PATH="/path/to/kma/1.6.6:${PATH}"

# CliqueSNV ships as a JAR, not a program on PATH, so the rMLST arm looks for
# it in BRIDGE_CLIQUESNV (unless config.yaml names it under tools: cliquesnv:).
# Point this at the JAR if your clique-snv module does not set it:
if [[ -z "${BRIDGE_CLIQUESNV:-}" ]] && ! command -v cliquesnv >/dev/null 2>&1; then
    export BRIDGE_CLIQUESNV=/path/to/clique-snv/2.0.3/clique-snv.jar
fi

# `module load` prints its error and carries on, so a failed load would only
# show up later, once per sample, on a compute node. Check here instead.
_missing=""
for _tool in kallisto mash minimap2 samtools blastn viral_consensus kma; do
    command -v "$_tool" >/dev/null 2>&1 || _missing="${_missing} ${_tool}"
done
if [[ -n "$_missing" ]]; then
    echo "tools.env WARNING: these are still not on PATH:${_missing}" >&2
    echo "  Check the module names above (module avail <tool>) and 'module list'." >&2
    echo "  A shell can inherit the list of loaded modules without their PATH" >&2
    echo "  entries (a reconnect, a nested shell), making 'module load' a no-op." >&2
    echo "  If 'module list' shows them loaded, reset and source this file again:" >&2
    echo "     module purge && source ${BASH_SOURCE[0]}" >&2
fi
unset _missing _tool

# Modules may put their own Python packages on PYTHONPATH, and a PYTHONPATH
# entry outranks the venv's installed code. Pin it to this repository so the
# venv's `bridge` runs the code in this folder and nothing else (the job
# scripts do the same).
export PYTHONPATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/src"
